# Required to analyze opportunities
GEMINI_API_KEY=your_gemini_api_key
# Optional. Use a Gemini model available to your API key.
GEMINI_MODEL=gemini-2.0-flash

# Required to deliver Telegram digests
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Comma-separated permitted RSS/Atom feeds. Leave blank to use the official defaults
# listed in README (GitHub, Google AI, AWS, Hugging Face, GSoC, OpenAI).
RSS_FEED_URLS=
# Optional. Leave blank to use app/sources/unstop_fixture.json. There is no known
# public Unstop feed/API configured by this MVP, so the app logs a warning at startup.
UNSTOP_API_URL=

# Runs the background pipeline on this interval after FastAPI starts.
SCHEDULE_INTERVAL_MINUTES=30

# Optional. Railway supplies this automatically after you add a PostgreSQL service.
# When absent, the app falls back to a local SQLite database.
DATABASE_URL=sqlite:///./opportunities.db

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
